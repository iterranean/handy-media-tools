#!/usr/bin/env bash
# Usage: $0 'DIRECTORY' 'PATTERN' [> touch.sh]
# Generates a list of commands to set file mtime/atime from EXIF creation date.

directory="${1:-}"
pattern="${2:-}"
[ -z "$directory" ] || [ -z "$pattern" ] && { echo "Usage: $0 'DIRECTORY' 'PATTERN'" >&2; exit 1; }

datestamp_cmd="$(dirname "$0")/exif-datestamp"

find "$directory" -name "$pattern" -type f ! -name '._*' -print0 | while IFS= read -r -d '' f; do
  ts=$("$datestamp_cmd" "$f") || continue
  touch_ts="${ts%-*}${ts#*-}"
  touch_ts="${touch_ts:0:8}${touch_ts:8:4}.${touch_ts:12:2}"
  printf "touch -a -m -t '%s' '%s'\n" "$touch_ts" "$f"
done
